<%@ page contentType="text/html;charset=UTF-8" %><!DOCTYPE html><html lang="vi"><head><title>Biểu mẫu sản phẩm</title></head><body><h1>${empty product ? 'Tạo' : 'Cập nhật'} sản phẩm</h1><form method="post" action="products"><input type="hidden" name="id" value="${product.id}"><p><label>Tên <input name="name" value="${product.name}" required></label></p><p><label>Giá <input type="number" min="0" step="0.01" name="price" value="${product.price}" required></label></p><p><label>Mô tả <textarea name="description" required>${product.description}</textarea></label></p><p><label>Nhà sản xuất <input name="manufacturer" value="${product.manufacturer}" required></label></p><button>Lưu</button></form><a href="products">Quay lại</a></body></html>
