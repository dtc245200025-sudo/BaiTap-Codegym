<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><!DOCTYPE html><html lang="vi"><head><title>Quản lý sản phẩm</title><style>body{font-family:Arial;margin:30px}table{border-collapse:collapse;width:100%}th,td{border:1px solid #ccc;padding:9px}th{background:#1b2a7a;color:white}</style></head><body><h1>Danh sách sản phẩm</h1><p><a href="products?action=create">Thêm sản phẩm</a></p><table><tr><th>ID</th><th>Tên</th><th>Giá</th><th>Số lượng</th><th>Thao tác</th></tr><c:forEach items="${products}" var="p"><tr><td>${p.id}</td><td>${p.name}</td><td>${p.price}</td><td>${p.quantity}</td><td><a href="products?action=view&id=${p.id}">Xem</a> <a href="products?action=edit&id=${p.id}">Sửa</a> <a href="products?action=delete&id=${p.id}" onclick="return confirm('Bạn chắc chắn muốn xóa sản phẩm này?')">Xóa</a></td></tr></c:forEach></table></body></html>
