<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><!DOCTYPE html><html lang="vi"><head><title>Quản lý sản phẩm</title><style>body{font-family:Arial;margin:30px}table{border-collapse:collapse;width:100%}th,td{border:1px solid #ccc;padding:9px}th{background:#1b2a7a;color:white}</style></head><body><h1>Danh sách sản phẩm</h1><form action="products"><input type="hidden" name="action" value="search"><input name="name" placeholder="Tên sản phẩm"><button>Tìm kiếm</button></form><p><a href="products?action=create">Tạo sản phẩm mới</a></p><table><tr><th>ID</th><th>Tên</th><th>Giá</th><th>Mô tả</th><th>Nhà sản xuất</th><th>Thao tác</th></tr><c:forEach items="${products}" var="p"><tr><td>${p.id}</td><td>${p.name}</td><td>${p.price}</td><td>${p.description}</td><td>${p.manufacturer}</td><td><a href="products?action=view&id=${p.id}">Xem</a> <a href="products?action=edit&id=${p.id}">Sửa</a> <a href="products?action=delete&id=${p.id}" onclick="return confirm('Xóa sản phẩm?')">Xóa</a></td></tr></c:forEach></table></body></html>
