<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<% String error=null; double rate=0,usd=0,vnd=0; try { rate=Double.parseDouble(request.getParameter("rate")); usd=Double.parseDouble(request.getParameter("usd")); if(rate<0||usd<0) throw new IllegalArgumentException(); vnd=rate*usd; } catch(Exception exception) { error="Dữ liệu đầu vào không hợp lệ"; } %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><title>Kết quả chuyển đổi</title><style>body{font-family:Arial;text-align:center;margin-top:100px}.ok{color:#15803d}.error{color:#b91c1c}</style></head><body><h2>Kết quả chuyển đổi</h2><% if(error==null){ %><p><%= usd %> USD × <%= rate %> =</p><h3 class="ok"><%= String.format("%,.0f",vnd) %> VNĐ</h3><% }else{ %><h3 class="error"><%= error %></h3><% } %><a href="index.jsp">Quay lại</a></body></html>
