<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><h1>Quản lý User</h1><form action="users" method="get"><input type="hidden" name="action" value="search"><input name="country" placeholder="Tìm theo quốc gia"><button>Tìm kiếm</button> <a href="users?action=sort">Sắp xếp theo tên</a></form><p><a href="users?action=new">Thêm User</a></p><table border="1"><tr><th>ID</th><th>Tên</th><th>Email</th><th>Quốc gia</th><th>Thao tác</th></tr><c:forEach items="${users}" var="u"><tr><td>${u.id}</td><td>${u.name}</td><td>${u.email}</td><td>${u.country}</td><td><a href="users?action=edit&id=${u.id}">Sửa</a> <a href="users?action=delete&id=${u.id}">Xóa</a></td></tr></c:forEach></table>
