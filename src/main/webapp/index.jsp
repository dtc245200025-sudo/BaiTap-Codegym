<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><title>Chuyển đổi tiền tệ</title><style>body{font-family:Arial;background:#f8fafc;display:flex;justify-content:center;margin-top:100px}.box{background:white;padding:36px;width:360px;border-radius:10px;box-shadow:0 4px 12px #0002}input,button{box-sizing:border-box;width:100%;padding:11px;margin:8px 0}button{background:#1b2a7a;color:white;border:0;border-radius:5px}</style></head><body><div class="box"><h2>USD sang VNĐ</h2><form action="converter.jsp" method="POST"><label>Tỉ giá (VNĐ/USD)<input type="number" name="rate" value="25000" step="any" min="0" required></label><label>Lượng USD<input type="number" name="usd" step="any" min="0" required></label><button type="submit">Tính toán</button></form></div></body></html>
